# Railway injects DATABASE_URL automatically when you attach a Postgres service.
# Leave it unset locally to use an embedded Postgres (PGlite) stored in ./.data
DATABASE_URL=
# Shared secret the mobile app sends in the x-app-token header. Set this in Railway!
APP_TOKEN=
# Speech-to-text. Groq has a free tier (console.groq.com/keys) and is used when set.
GROQ_API_KEY=
# Optional paid fallback, used only if GROQ_API_KEY is empty
OPENAI_API_KEY=
# Optional override (defaults: whisper-large-v3 on Groq, gpt-4o-mini-transcribe on OpenAI)
TRANSCRIBE_MODEL=
PORT=3000
