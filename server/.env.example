# Railway injects DATABASE_URL automatically when you attach a Postgres service.
# Leave it unset locally to use an embedded Postgres (PGlite) stored in ./.data
DATABASE_URL=
# Shared secret the mobile app sends in the x-app-token header. Set this in Railway!
APP_TOKEN=
# Used for speech-to-text (server-side transcription)
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
PORT=3000
